{
  "mcpServers": {
    "gridcraft": {
      "command": "node",
      "args": [
        "./dist/bundle.cjs"
      ],
      "cwd": ".",
      "env_vars": [
        "PATH",
        "Path",
        "HOME",
        "USERPROFILE",
        "LOCALAPPDATA",
        "APPDATA",
        "ProgramFiles",
        "ProgramFiles(x86)",
        "TEMP",
        "TMP",
        "TMPDIR",
        "SystemRoot",
        "XDG_CONFIG_HOME",
        "XDG_DATA_HOME",
        "DISPLAY",
        "WAYLAND_DISPLAY",
        "GRIDCRAFT_DIR",
        "GRIDCRAFT_CLI",
        "GRIDCRAFT_CONTROL_PORT",
        "GRIDCRAFT_APP",
        "GRIDCRAFT_MCP_TIMEOUT"
      ],
      "startup_timeout_sec": 60,
      "tool_timeout_sec": 3600
    }
  }
}
